{
  "name": "agenthub-codex",
  "displayName": "AgentHub for Codex",
  "description": "Monitor and control multiple Codex app-server sessions from one VS Code view.",
  "version": "0.1.3",
  "publisher": "local",
  "repository": {
    "type": "git",
    "url": "https://github.com/KayD0/agent-hub.git"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:agentHub.sessions"
  ],
  "main": "./dist/src/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentHub",
          "title": "AgentHub",
          "icon": "media/agenthub.svg"
        }
      ]
    },
    "views": {
      "agentHub": [
        {
          "id": "agentHub.sessions",
          "name": "Codex Sessions",
          "type": "webview"
        },
        {
          "id": "agentHub.repositories",
          "name": "Repository Groups",
          "type": "webview"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "agentHub.sessions",
        "contents": "Codexセッションはまだありません。\n[新しいセッションを開始](command:agentHub.startSession)"
      }
    ],
    "commands": [
      {
        "command": "agentHub.startSession",
        "title": "AgentHub: 新しいCodexセッション"
      },
      {
        "command": "agentHub.login",
        "title": "ChatGPT: ログイン"
      },
      {
        "command": "agentHub.loginDeviceCode",
        "title": "AgentHub: デバイスコードでログイン"
      },
      {
        "command": "agentHub.cancelLogin",
        "title": "AgentHub: ログインをキャンセル",
        "icon": "$(close)"
      },
      {
        "command": "agentHub.logout",
        "title": "ChatGPT: ログアウト"
      },
      {
        "command": "agentHub.refresh",
        "title": "AgentHub: セッション一覧を更新"
      },
      {
        "command": "agentHub.filterSessionsByRepository",
        "title": "フォルダでセッションを絞り込む",
        "icon": "$(filter)"
      },
      {
        "command": "agentHub.enableBulkAuto",
        "title": "一括Autoを有効にする",
        "icon": "$(circle-large-outline)"
      },
      {
        "command": "agentHub.disableBulkAuto",
        "title": "一括Autoを無効にする",
        "icon": "$(pass-filled)"
      },
      {
        "command": "agentHub.enableBulkUnrestrictedAuto",
        "title": "一括無制限Autoを有効にする",
        "icon": "$(warning)"
      },
      {
        "command": "agentHub.disableBulkUnrestrictedAuto",
        "title": "一括無制限Autoを無効にする",
        "icon": "$(pass-filled)"
      },
      {
        "command": "agentHub.openSession",
        "title": "AgentHub: セッション詳細を開く"
      },
      {
        "command": "agentHub.addRepository",
        "title": "AgentHub: フォルダを登録"
      },
      {
        "command": "agentHub.openRepositoryChanges",
        "title": "AgentHub: グループ差分を開く"
      },
      {
        "command": "agentHub.openRepositoryIssues",
        "title": "AgentHub: GitHub Issuesを開く"
      },
      {
        "command": "agentHub.refreshRepositories",
        "title": "AgentHub: リポジトリ差分を更新"
      },
      {
        "command": "agentHub.openSetup",
        "title": "AgentHub: セットアップと診断"
      },
      {
        "command": "agentHub.openCodexRules",
        "title": "AgentHub: Codex rulesを開く",
        "icon": "$(law)"
      },
      {
        "command": "agentHub.redetectEnvironment",
        "title": "AgentHub: 利用環境を再診断"
      },
      {
        "command": "agentHub.showLogs",
        "title": "AgentHub: ログを表示"
      },
      {
        "command": "agentHub.exportDiagnostics",
        "title": "AgentHub: 診断情報をエクスポート"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agentHub.login",
          "when": "view == agentHub.sessions && agentHub.authenticationStatus != authenticated && agentHub.authenticationStatus != logging_in",
          "group": "navigation@1"
        },
        {
          "command": "agentHub.logout",
          "when": "view == agentHub.sessions && agentHub.authenticationStatus == authenticated",
          "group": "navigation@1"
        },
        {
          "command": "agentHub.cancelLogin",
          "when": "view == agentHub.sessions && agentHub.authenticationStatus == logging_in",
          "group": "navigation@1"
        },
        {
          "command": "agentHub.filterSessionsByRepository",
          "when": "view == agentHub.sessions && agentHub.authenticationStatus == authenticated && agentHub.hasRepositoryGroups",
          "group": "navigation@2"
        },
        {
          "command": "agentHub.openCodexRules",
          "when": "view == agentHub.sessions",
          "group": "navigation@3"
        },
        {
          "command": "agentHub.enableBulkAuto",
          "when": "view == agentHub.sessions && agentHub.authenticationStatus == authenticated && !agentHub.bulkAutoEnabled",
          "group": "navigation@4"
        },
        {
          "command": "agentHub.disableBulkAuto",
          "when": "view == agentHub.sessions && agentHub.authenticationStatus == authenticated && agentHub.bulkAutoEnabled",
          "group": "navigation@4"
        },
        {
          "command": "agentHub.enableBulkUnrestrictedAuto",
          "when": "view == agentHub.sessions && agentHub.authenticationStatus == authenticated && !agentHub.bulkUnrestrictedAutoEnabled",
          "group": "navigation@5"
        },
        {
          "command": "agentHub.disableBulkUnrestrictedAuto",
          "when": "view == agentHub.sessions && agentHub.authenticationStatus == authenticated && agentHub.bulkUnrestrictedAutoEnabled",
          "group": "navigation@5"
        },
        {
          "command": "agentHub.addRepository",
          "when": "view == agentHub.repositories",
          "group": "navigation@1"
        },
        {
          "command": "agentHub.refreshRepositories",
          "when": "view == agentHub.repositories",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "AgentHub",
      "properties": {
        "agentHub.codexPath": {
          "type": "string",
          "default": "",
          "description": "Optional Codex CLI executable path. When empty, AgentHub detects codex from PATH."
        },
        "agentHub.codexArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Arguments inserted before app-server. Intended for test harnesses and custom launchers."
        },
        "agentHub.notifyOnActionRequired": {
          "type": "boolean",
          "default": true,
          "description": "Show notifications when a session needs approval or input."
        },
        "agentHub.notifyOnComplete": {
          "type": "boolean",
          "default": true,
          "description": "Show notifications when a session completes."
        },
        "agentHub.notifyOnFailure": {
          "type": "boolean",
          "default": true,
          "description": "Show notifications when a session fails."
        },
        "agentHub.autoApprove.allowedCommands": {
          "type": "array", "items": { "type": "string" }, "default": [],
          "description": "Auto承認するコマンドの完全一致リスト。"
        },
        "agentHub.autoApprove.allowedCommandPrefixes": {
          "type": "array", "items": { "type": "string" },
          "default": ["git status", "git diff", "git log", "git branch", "git add", "git commit", "git push", "gh issue", "gh pr"],
          "description": "Auto承認するコマンド接頭辞。force push、削除、reset --hard、cleanは一致しても手動確認になります。"
        },
        "agentHub.autoApprove.allowedPaths": {
          "type": "array", "items": { "type": "string" }, "default": ["${sessionRoot}"],
          "description": "Auto承認するファイル変更パス。${sessionRoot}はセッションの作業フォルダです。"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -p . -w",
    "test": "npm run compile && node --test dist/test/*.test.js",
    "test:unit": "npm run compile && node --test dist/test/authentication-manager.test.js dist/test/approval-policy.test.js dist/test/session-manager.test.js dist/test/markdown-renderer.test.js dist/test/git-repository-reader.test.js dist/test/repository-file-reader.test.js dist/test/github-issue-client.test.js dist/test/session-webview-dom.test.js dist/test/session-detail-webview-dom.test.js dist/test/file-logger.test.js",
    "test:protocol": "npm run compile && node --test dist/test/protocol-boundaries.test.js",
    "test:app-server": "npm run compile && node --test dist/test/app-server-client.test.js",
    "test:extension": "npm run compile && node scripts/run-extension-tests.js",
    "vscode:prepublish": "npm run compile",
    "verify:vsix": "node scripts/verify-package-contents.js",
    "package:vsix": "npm run verify:vsix && vsce package --githubBranch develop --out releases/agenthub-codex.vsix",
    "release:check": "npm test && npm run package:vsix"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.100.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "markdown-it": "^15.0.0"
  }
}
